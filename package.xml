<?xml version="1.0"?>
<package format="3">
  <name>compas_rrc_driver</name>
  <version>1.2.0</version>
  <description>COMPAS RRC: ROS 2 Driver</description>

  <maintainer email="casas@arch.ethz.ch">Gonzalo Casas</maintainer>
  <maintainer email="fleischmann@arch.ethz.ch">Philippe Fleischmann</maintainer>
  <maintainer email="lyrenmann@arch.ethz.ch">Michael Lyrenmann</maintainer>

  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
